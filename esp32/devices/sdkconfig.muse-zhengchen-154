# Zhengchen 1.54 TFT Wi-Fi: ESP32-S3, 16 MB flash, 8 MB octal PSRAM,
# 240x240 ST7789, native USB, three active-low buttons, INMP441-style I2S mic
# and MAX98357A I2S speaker. Pins and display behaviour were validated in
# FriendOS; the audio layout matches xiaozhi-esp32's simplex no-codec boards.
# Loaded after sdkconfig.defaults by the project's top-level CMakeLists.txt.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_ZHENGCHEN_154=y

# Muse UI, pairing, OTA and 16 MB partition layout.
CONFIG_HOMEHUB_LED_BACKEND_MUSE=y
CONFIG_HOMEHUB_BLE_NAME_PREFIX="MuseGadget"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_HOMEHUB_OTA_ENABLED=y

# GPIO20 is the active-high LCD backlight on this board. ESP32-S3 native USB
# Serial/JTAG also owns GPIO19/20, so leave console output on UART0 and disable
# the native USB block after boot. Download mode can still use it for recovery.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# LVGL avatar and settings UI.
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# BLE, crypto and network memory settings used by the on-device Muse UI.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION=n
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_USE_GIF=y
CONFIG_LV_USE_QRCODE=y
