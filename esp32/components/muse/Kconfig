menu "Muse"

    config MUSE_BOARD_ZHENGCHEN_154
        bool "Zhengchen 1.54 TFT Wi-Fi"
        depends on IDF_TARGET_ESP32S3
        default y

    config MUSE_ENABLED
        bool
        default y if MUSE_BOARD_ZHENGCHEN_154

    # Always defined, unlike the target-dependent board options, so
    # idf_component.yml rules can select each board's managed components.
    config MUSE_BOARD_ID
        string
        default "zhengchen_154" if MUSE_BOARD_ZHENGCHEN_154
        default "none"

    # The Muse tools' serial port: the console UART behind the board's USB
    # bridge, where the chip's own USB Serial/JTAG isn't wired to a connector
    # (the Watcher's USB-C goes to a CH342) or the chip has none.
    config MUSE_CONSOLE_UART
        bool
        default y if !SOC_USB_SERIAL_JTAG_SUPPORTED

    config MUSE_HATCH
        bool "Gemini Live voice session"
        depends on MUSE_ENABLED
        default y if SPIRAM
        default n
        help
            Push-to-talk turns use the Gemini Live WebSocket API. Needs PSRAM.

    config MUSE_GEMINI_API_KEY
        string "Gemini API key (optional compiled default)"
        depends on MUSE_HATCH
        default ""
        help
            API key used only when no key has been saved in NVS through the
            Bluetooth setup page. The value is compiled into the firmware and
            stored in build/sdkconfig. Do not commit sdkconfig or share the
            resulting firmware binary when this field contains a real key.

endmenu
